rules_version = '2';

// Each user's data lives in a single document at users/{uid}.
// A signed-in user may read and write only their own document — never anyone
// else's. Access control lives entirely here (the Firebase web config in
// src/firebase.ts is public by design), so these rules are the security
// boundary for the whole app. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Automatic capture. The inbox key is a random 64-char secret stored in the
    // user's settings; the doc at inboxes/{key} records which user owns it.
    // iPhone shortcuts (unauthenticated, via the REST API) may only APPEND
    // items to an existing inbox — never read, list, update or delete. Only
    // the signed-in owner can read and clear them.
    match /inboxes/{key} {
      allow create: if request.auth != null
        && key.size() == 64
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /items/{itemId} {
        allow create: if exists(/databases/$(database)/documents/inboxes/$(key))
          && request.resource.data.keys().hasOnly(['source', 'text', 'amount', 'merchant', 'card', 'category', 'description', 'at'])
          && request.resource.data.source in ['applepay', 'sms']
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
          && (!('merchant' in request.resource.data) || (request.resource.data.merchant is string && request.resource.data.merchant.size() <= 200))
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 200))
          && (!('amount' in request.resource.data) || (request.resource.data.amount is string && request.resource.data.amount.size() <= 40))
          && (!('card' in request.resource.data) || (request.resource.data.card is string && request.resource.data.card.size() <= 100))
          && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 50))
          && (!('at' in request.resource.data) || (request.resource.data.at is string && request.resource.data.at.size() <= 50));
        allow read, delete: if request.auth != null
          && get(/databases/$(database)/documents/inboxes/$(key)).data.uid == request.auth.uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
